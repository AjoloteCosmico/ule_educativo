+<script>(function(){let allRefs=[],relacionados={};const list=document.getElementById('bibliografia-list'),contador=document.getElementById('contador-bibliografia'),inputBuscar=document.getElementById('buscar-bibliografia'),selectTipo=document.getElementById('tipo-bibliografia'),selectOrden=document.getElementById('orden-bibliografia');function poblarTipos(r){Array.from(new Set(r.map(x=>x.tipo).filter(Boolean))).sort().forEach(t=>{const o=document.createElement('option');o.value=t;o.textContent=ULE.labels.tipoBiblioLabel(t);selectTipo.appendChild(o);});}function coincide(r,t){if(!t)return true;const a=Array.isArray(r.autores)?r.autores.join(' '):(r.autores||'');return[r.titulo,a,r.editorial,r.resumen,ULE.labels.tipoBiblioLabel(r.tipo)].join(' ').toLowerCase().includes(t.toLowerCase());}function render(){const t=inputBuscar.value.trim(),tipo=selectTipo.value,orden=selectOrden.value;let f=allRefs.filter(r=>coincide(r,t)&&(!tipo||r.tipo===tipo));f.sort((a,b)=>{const ya=Number(a.año)||0,yb=Number(b.año)||0;return orden==='asc'?ya-yb:yb-ya;});list.innerHTML='';if(!f.length)list.innerHTML='<div class="catalog-empty">No hay referencias que coincidan con tu búsqueda.</div>';else f.forEach(r=>{const c=document.createElement('biblio-card');c.setAttribute('data-id',r.id||'');c.setAttribute('data-title',r.titulo||'');c.setAttribute('data-authors',Array.isArray(r.autores)?r.autores.join(', '):(r.autores||''));c.setAttribute('data-year',r.año||'');c.setAttribute('data-type',r.tipo||'');c.setAttribute('data-editorial',r.editorial||'');c.setAttribute('data-url',r.url||'');c.setAttribute('data-summary',r.resumen||'');c.setAttribute('data-related-articles',JSON.stringify(relacionados[r.id]||[]));c.setAttribute('data-heading-level','2');list.appendChild(c);});contador.textContent=f.length===1?'1 referencia encontrada':f.length+' referencias encontradas';}async function init(){try{allRefs=await ULE.loader.loadBibliografia();try{relacionados=await ULE.loader.loadRelatedArticlesMap();}catch(e){console.warn('[ULE] Sin artículos relacionados:',e);}poblarTipos(allRefs);render();}catch(e){console.error('[ULE] Error cargando bibliografía:',e);list.innerHTML='<div class="catalog-empty" role="alert">No fue posible cargar la bibliografía. Inténtalo de nuevo en unos minutos.</div>';contador.textContent='';}}inputBuscar.addEventListener('input',render);selectTipo.addEventListener('change',render);selectOrden.addEventListener('change',render);init();})();</script>

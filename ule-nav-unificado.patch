+<body data-ad-page="catalogos">
+<a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
+<ule-nav></ule-nav>
+<main id="contenido-principal">
+<section class="container section"><h1>Colecciones</h1><p>Explora colecciones visuales relacionadas con el juego de pelota. Selecciona una colección y utiliza sus filtros para acercarte a los elementos que te interesen.</p><div class="catalog-selector"><label for="selector-catalogo">Colección</label><select id="selector-catalogo"><option value="">Cargando colecciones…</option></select></div><p id="catalogo-aviso" class="filtros__resultados" role="status"></p><div id="catalogo-contenido"><div class="catalog-loading" role="status">Cargando catálogo…</div></div></section>
+<section class="container section ad-section" aria-labelledby="anuncios-catalogos"><h2 class="ad-section__title" id="anuncios-catalogos">Comunidad</h2><div data-ad-slot data-ad-horizontal="true"></div></section>
+</main>
+<footer class="container section" style="text-align:center; opacity:0.7; font-size:var(--fs-anotacion);"><p>ule educativo · 2026</p></footer>
+<auth-modal id="auth-modal"></auth-modal>
+<script src="js/main.js"></script>
+<script src="js/ule-nav.js"></script>
+<script src="js/api/client.js"></script>
+<script src="js/api/auth.js"></script>
+<script src="js/api/session.js"></script>
+<script src="js/auth-modal.js"></script>
+<script src="js/auth-ui.js"></script>
+<script src="js/loader.js"></script>
+<script src="js/components.js"></script>
+<script src="js/ads.js"></script>
+
+<script>
+(function () {
+  const selector = document.getElementById('selector-catalogo');
+  const contenido = document.getElementById('catalogo-contenido');
+  const aviso = document.getElementById('catalogo-aviso');
+
+  function nombreCatalogo(id) {
+    return id.replace(/\.json$/, '').split('-').map(function (p) { return p.charAt(0).toUpperCase() + p.slice(1); }).join(' ');
+  }
+
+  function sinOpciones(mensaje, cuerpo, esError) {
+    selector.innerHTML = '';
+    const o = document.createElement('option');
+    o.value = '';
+    o.textContent = mensaje;
+    selector.appendChild(o);
+    selector.disabled = true;
+    contenido.innerHTML = '<div class="catalog-empty"' + (esError ? ' role="alert"' : '') + '>' + cuerpo + '</div>';
+  }
+
+  function sincronizarUrl(catalogoId, conservarPieza) {
+    const url = new URL(window.location.href);
+    url.searchParams.set('catalogo', catalogoId);
+    if (!conservarPieza) url.searchParams.delete('pieza');
+    window.history.replaceState({}, '', url);
+  }
+
+  function mostrarCatalogo(id, piezaId) {
+    if (!id) return;
+    aviso.textContent = '';
+    contenido.innerHTML = '';
+    const grid = document.createElement('catalog-grid');
+    grid.setAttribute('data-catalog', id);
+    contenido.appendChild(grid);
+    sincronizarUrl(id, !!piezaId);
+
+    if (piezaId) {
+      grid.whenReady().then(function (ok) {
+        if (ok && !grid.openItemById(piezaId)) {
+          aviso.textContent = 'No se encontró el elemento solicitado en esta colección.';
+          sincronizarUrl(id, false);
+        }
+      });
+    }
+  }
+
+  async function init() {
+    try {
+      const ids = await ULE.loader.listCatalogIds();
+      if (!ids.length) {
+        sinOpciones('No hay colecciones disponibles', 'No hay colecciones disponibles por el momento.');
+        return;
+      }
+
+      const catalogs = await Promise.all(ids.map(function (id) { return ULE.loader.loadCatalog(id); }));
+      const visibles = catalogs.filter(function (c) { return c && c.visible !== false; });
+      if (!visibles.length) {
+        sinOpciones('No hay colecciones disponibles', 'No hay colecciones visibles por el momento.');
+        return;
+      }
+
+      selector.innerHTML = '';
+      visibles.forEach(function (c) {
+        const o = document.createElement('option');
+        o.value = c.id;
+        o.textContent = c.titulo || nombreCatalogo(c.id);
+        selector.appendChild(o);
+      });
+      selector.disabled = false;
+
+      const params = new URLSearchParams(window.location.search);
+      const piezaId = params.get('pieza');
+      let inicial = visibles.find(function (c) { return c.id === params.get('catalogo'); });
+      if (!inicial && piezaId) {
+        inicial = visibles.find(function (c) {
+          return Array.isArray(c.elementos) && c.elementos.some(function (e) { return e.id === piezaId; });
+        });
+      }
+      inicial = inicial || visibles[0];
+
+      selector.value = inicial.id;
+      mostrarCatalogo(inicial.id, piezaId);
+    } catch (e) {
+      console.error('[ULE] Error cargando catálogos:', e);
+      sinOpciones('No fue posible cargar las colecciones', 'No fue posible cargar las colecciones. Inténtalo de nuevo en unos minutos.', true);
+    }
+  }
+
+  selector.addEventListener('change', function () { mostrarCatalogo(selector.value); });
+  init();
+})();
+</script>
+
+</body></html>
